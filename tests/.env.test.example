# Copy to .env.test (or export in your shell / CI) before running the API
# suite. Reuses the same role-credential env vars as e2e/.env.e2e.example so
# one set of test accounts configures both the UI and API suites. Never
# commit real credentials — tests skip automatically per role when unset.

# E2E_BASE_URL=http://localhost:8080
# FASTAPI_BASE_URL=http://localhost:8000

# Reused from the frontend's own .env — set them here too if running the
# API suite without the frontend's .env already loaded in your shell.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Setup/verification only — never used to assert what an end-user role can
# do. Required only for the "branch_manager sees every profile row" test.
# SUPABASE_SERVICE_ROLE_KEY=

E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=

E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

E2E_RISK_EMAIL=
E2E_RISK_PASSWORD=

E2E_AUDIT_EMAIL=
E2E_AUDIT_PASSWORD=

RUN_LIVE_OPENROUTER_TESTS=false
