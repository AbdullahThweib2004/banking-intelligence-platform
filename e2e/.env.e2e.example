# Copy to .env.e2e (or export in your shell / CI) before running the E2E suite.
# Never commit real credentials. Tests for a role are skipped automatically
# if that role's pair is not set.

# E2E_BASE_URL=http://localhost:8080

E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=

E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

E2E_RISK_EMAIL=
E2E_RISK_PASSWORD=

E2E_AUDIT_EMAIL=
E2E_AUDIT_PASSWORD=
